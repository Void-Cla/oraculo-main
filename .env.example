DB_PATH=./dados/oraculo.sqlite
PORT=8000
GPT_API_KEY=sk-proj-...          # opcional — AI Advisor usa GPT-4o-mini
BINANCE_API_KEY=                 # sua API key da Binance
BINANCE_API_SECRET=              # sua API secret da Binance
BINANCE_TESTNET=true             # true = testnet, false = conta real
PERMITIR_CONTA_REAL=false        # mude para true com cautela

# Coleta contínua de dados (acumula material real para pesquisa de edge)
ATIVAR_COLETA_CONTINUA=true               # liga o coletor contínuo no startup
COLETA_SIMBOLOS=BTCUSDT,ETHUSDT,BNBUSDT   # vazio = pares USDT primários
COLETA_INTERVALO_SEGUNDOS=60              # velas são 1m → 1 coleta/min é o natural

# Micro-trading 1-15m operacional (TESTNET-only; relaxa pisos, EV negativo permitido)
AUTO_MODO_EXPLORACAO=false                # true só para validar/exercitar o ciclo no testnet

# Governança de EDGE — gate de lucratividade da CONTA REAL (default-closed / fail-safe)
# A entrada real num símbolo só é liberada se o walk-forward provou edge líquido (net/trade>0)
# E enquanto a validação estiver fresca. Sem isso, o bot opera só testnet/exploração.
EDGE_VALIDADE_DIAS=7              # edge validado há mais que isto EXPIRA (re-validar = re-rodar backtest)
EDGE_MIN_TRADES=30               # mínimo de trades out-of-sample p/ confiar no veredito
EDGE_IC_MINIMO=0.02              # IC walk-forward mínimo (margem sobre ruído)
EDGE_MARGEM_MINIMA_PCT=0.0       # retorno líquido médio/trade mínimo p/ ligar o edge

# Blindagem AA+ (blueprint botai.md)
# Kill-switch financeiro: crie o arquivo p/ bloquear TODA ordem; remova p/ liberar.
KILL_SWITCH_PATH=./dados/KILL_SWITCH
# Integridade de modelo (anti-RCE no joblib.load). Defina p/ exigir assinatura HMAC dos modelos.
MODELO_HMAC_KEY=                          # vazio = verificacao desligada (comportamento legado)
# Hardening de producao: sob AMBIENTE=producao o boot exige COOKIE_SECURE=true (fail-fast).
AMBIENTE=                                 # producao | (vazio = dev)
COOKIE_SECURE=false                       # true em producao (HTTPS)

# === CAMADA AGENTICA DE IA (cerebro consultivo — fail-open; provedor PLUGAVEL) ===
# Escolha do provedor de IA da camada de DECISAO (veto + voto direcional + auditoria).
# Trocar de IA = so mudar AI_PROVIDER e preencher a chave correspondente abaixo.
# Valores: nvidia | gemini | gpt | claude | ollama  (case-insensitive; invalido = cai no default nvidia)
AI_PROVIDER=nvidia                        # nvidia (default) | gemini | gpt | claude | ollama

# -- Provedor NVIDIA NIM (integrate.api.nvidia.com) — usado quando AI_PROVIDER=nvidia --
NVIDIA_API_KEY=                           # aceita tambem Nvidia_API_Key / NVAPI_KEY
# Nvidia_API_Key=                         # alternativa (mesmo efeito)
NVIDIA_MODEL=z-ai/glm-5.2                 # modelo NIM; API OpenAI-compat
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# -- Provedor GEMINI (Google) --
GEMINI_API_KEY=                           # chave do provedor gemini; vazio = camada desativada
GEMINI_MODEL=gemini-2.0-flash             # default barato/rapido p/ saida JSON

# -- Provedor GPT (OpenAI) — usado quando AI_PROVIDER=gpt --
GPT_API_KEY=                              # chave OpenAI (aceita tambem OPENAI_API_KEY)
# OPENAI_API_KEY=                         # alternativa a GPT_API_KEY (qualquer uma serve)
GPT_MODEL=gpt-4o-mini                     # default barato; suporta response_format json_object

# -- Provedor CLAUDE (Anthropic) — usado quando AI_PROVIDER=claude --
CLAUDE_API_KEY=                           # chave Anthropic (aceita tambem ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=                      # alternativa a CLAUDE_API_KEY (qualquer uma serve)
CLAUDE_MODEL=claude-haiku-4-5             # default barato/rapido; NAO enviamos temperature (modelos novos rejeitam)

# -- Provedor OLLAMA (LLM LOCAL) — usado quando AI_PROVIDER=ollama --
# Roda 100% na sua maquina (https://ollama.com) — sem chave de API, sem dado saindo daqui.
# Mantem a "opiniao de IA" viva mesmo com a internet caida ou o Gemini/GPT/Claude sem cota.
# O bot mecanico NUNCA dependeu de IA nenhuma para operar (DA-23) — isto e so disponibilidade.
# Antes de usar: instale o Ollama e rode `ollama pull qwen2.5:7b-instruct` (ou outro modelo).
OLLAMA_URL=http://127.0.0.1:11434         # endereco do servidor Ollama local
OLLAMA_MODEL=qwen2.5:7b-instruct          # 7-8B quantizado segura JSON estruturado em CPU

# -- Flags da camada agentica (valem p/ qualquer provedor) --
AI_FILTER_ENABLED=true                    # filtro de pre-execucao (veto) + voto direcional
AI_AUDITOR_ENABLED=true                   # cron de auditoria pos-trade
AI_FILTER_TIMEOUT_SEGUNDOS=12             # hard limit do veto/voto — o bot nao espera a IA alem disso
AI_FILTER_MIN_CONFIDENCE_ABORT=0.70       # confianca minima p/ honrar um VETO da IA
AI_AUDITOR_INTERVALO_HORAS=2

# -- Cost-control GENERICO da IA (vale p/ QUALQUER provedor: gemini/gpt/claude) --
# Se ausentes, os nomes legados GEMINI_* abaixo ainda sao respeitados (retrocompat).
IA_TIMEOUT_SEGUNDOS=15                    # timeout duro da chamada de rede (piso 1.0s)
IA_MAX_CALLS_DIA=50                       # teto de chamadas/dia (cost-control)
IA_MAX_CALLS_HORA=10                      # teto de chamadas/hora
IA_FALHAS_COOLDOWN=5                      # apos N falhas consecutivas, entra em cooldown
IA_COOLDOWN_MIN=60                        # duracao do cooldown em minutos
IA_MAX_TOKENS=1024                        # max tokens de saida por chamada

# -- Nomes LEGADOS do cost-control (so p/ o provedor gemini; tem precedencia se definidos) --
# GEMINI_TIMEOUT_SEGUNDOS=15
# GEMINI_MAX_CALLS_DIA=50
# GEMINI_MAX_CALLS_HORA=10
# GEMINI_FALHAS_COOLDOWN=5
# GEMINI_COOLDOWN_MIN=60

# === ALERTAS (halt financeiro, erros consecutivos, bot reiniciou em halt) — up.md P0 ===
# Um bot autonomo que falha em silencio e o maior risco. Configure PELO MENOS um canal.
# Sem nenhuma env abaixo definida, alertas.py fica NO-OP silencioso (fail-open, nao quebra o boot).
ALERTA_TELEGRAM_BOT_TOKEN=                # token do BotFather (crie um bot no Telegram)
ALERTA_TELEGRAM_CHAT_ID=                  # seu chat_id (fale com @userinfobot p/ descobrir)
ALERTA_WEBHOOK_URL=                       # alternativa/complemento: Slack/Discord/n8n (POST JSON)
ALERTA_COOLDOWN_SEGUNDOS=300              # nao repete o MESMO tipo de alerta antes disso (anti-flood)

# === BACKUP DO SQLITE (scripts/backup_sqlite.py) — up.md P0 ===
# Rode manualmente ou agende (ex.: Windows Task Scheduler / cron). Nao roda sozinho.
BACKUP_DIR=./dados/backups                # destino dos backups (VACUUM INTO, consistente c/ WAL)
BACKUP_RETENCAO_ARQUIVOS=72               # mantem os N mais recentes (72 = 3 dias a 1/hora)
