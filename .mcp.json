{
  "mcpServers": {
    "filesystem": {
      "command": "node",
      "args": [
        ".ferramentas/mcp/node-core/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
        "."
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "mcp-server-git",
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "git+https://github.com/oraios/serena@1bbe53546124c00e4238972f1599a91fbf8c6539",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        ".",
        "--transport",
        "stdio",
        "--enable-web-dashboard",
        "False",
        "--open-web-dashboard",
        "False",
        "--enable-gui-log-window",
        "False"
      ]
    },
    "semgrep": {
      "command": ".ferramentas/mcp/python/.venv/Scripts/python.exe",
      "args": [
        "scripts/mcp/semgrep_local_mcp.py"
      ],
      "env": {
        "SEMGREP_SEND_METRICS": "off"
      }
    }
  }
}
